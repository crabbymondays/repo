<?xml version="1.0" encoding="UTF-8"?>
<addons>
    <addon id="repository.curatr" name="curatr Repository" version="1.0.1" provider-name="crabbymondays">
        <extension point="xbmc.addon.repository" name="curatr Repository">
            <dir>
                <info compressed="false">https://crabbymondays.github.io/repo/repo/addons.xml</info>
                <checksum>https://crabbymondays.github.io/repo/repo/addons.xml.md5</checksum>
                <datadir>https://crabbymondays.github.io/repo/repo/</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Install and update curatr</summary>
            <description lang="en_GB">The official Kodi repository for curatr releases.</description>
            <platform>all</platform>
            <license>MIT</license>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
            <source>https://github.com/crabbymondays/repo</source>
            <website>https://crabbymondays.github.io/repo/</website>
        </extension>
    </addon>
    <addon id="plugin.video.curatr" name="curatr" version="1.0.27" provider-name="crabbymondays">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
            <import addon="script.module.requests" />
        </requires>
        <extension point="xbmc.python.pluginsource" library="plugin.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.service" library="service.py" />
        <extension point="kodi.context.item">
            <menu id="kodi.core.main">
                <menu>
                    <label>32820</label>
                    <item library="context.py" args="add_to_list">
                        <label>32821</label>
                        <visible>Addon.SettingBool(plugin.video.curatr,context_menu_enabled) + Addon.SettingBool(plugin.video.curatr,context_add_to_list) + !String.IsEqual(ListItem.Property(CuratrItem),true) + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)]</visible>
                    </item>
                    <item library="context.py" args="add_to_folder">
                        <label>32822</label>
                        <visible>Addon.SettingBool(plugin.video.curatr,context_menu_enabled) + Addon.SettingBool(plugin.video.curatr,context_add_to_folder) + !String.IsEqual(ListItem.Property(CuratrItem),true) + ListItem.IsFolder</visible>
                    </item>
                    <item library="context.py" args="find_similar">
                        <label>32823</label>
                        <visible>Addon.SettingBool(plugin.video.curatr,context_menu_enabled) + Addon.SettingBool(plugin.video.curatr,context_find_similar) + !String.IsEqual(ListItem.Property(CuratrItem),true) + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)]</visible>
                    </item>
                </menu>
            </menu>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Personalised movie and TV show lists for Kodi.</summary>
            <description lang="en_GB">Create and maintain personalised movie and TV show lists from natural-language requests. Use Keyword Matching without AI, connect an optional AI service for nuanced recommendations, browse locally in Kodi, and optionally sync lists to Trakt. Dynamic Lists can merge existing lists and add-on paths without AI.</description>
            <platform>all</platform>
            <disclaimer lang="en_GB">curatr sends prompts and likes / dislikes information to the services you enable. API keys and Trakt tokens are stored locally by Kodi and are never included in curatr backups.</disclaimer>
            <license>MIT; CC BY 4.0 (Font Awesome icons)</license>
            <assets>
                <icon>icon_v4.png</icon>
            </assets>
            <source>https://github.com/crabbymondays/repo</source>
            <website>https://crabbymondays.github.io/repo/</website>
            <news>curatr 1.0.27 updates the add-on icon and gives Dynamic Lists its own layer-group icon. Player settings use clearer Movie Player and Series Player labels. Home widgets carry executable action targets directly. Theme shading is concentrated at the edges and also appears on colour swatches, with a smaller rounded background preview.</news>
        </extension>
    </addon>
</addons>
