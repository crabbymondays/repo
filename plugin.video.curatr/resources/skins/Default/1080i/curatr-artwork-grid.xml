                </control>
                <control type="image">
                    <left>58</left><top>16</top><width>304</width><height>304</height>
                    <aspectratio align="center" aligny="center">keep</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="label">
                    <left>40</left><top>334</top><width>340</width><height>32</height>
                    <font>font13</font><textcolor>FFFFFFFF</textcolor><align>center</align>
                    <label>$INFO[ListItem.Label]</label>
