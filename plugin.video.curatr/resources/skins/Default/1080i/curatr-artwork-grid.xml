                <control type="label">
                    <left>40</left><top>368</top><width>340</width><height>26</height>
                    <font>font13</font><textcolor>FFAAAAAA</textcolor><align>center</align>
                    <label>$INFO[ListItem.Property(CuratrSubtitle)]</label>
