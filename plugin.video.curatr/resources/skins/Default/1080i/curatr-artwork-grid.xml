<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">100</defaultcontrol>
    <coordinates>
        <system>1</system>
        <origin x="0" y="0" />
    </coordinates>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="ED101018">special://home/addons/plugin.video.curatr/resources/media/pixel.png</texture>
        </control>
        <control type="label" id="10">
            <left>100</left><top>42</top><width>1720</width><height>58</height>
            <font>font30</font><textcolor>FFFFFFFF</textcolor><align>center</align>
            <label>Choose artwork</label>
        </control>
        <control type="label">
            <left>100</left><top>102</top><width>1720</width><height>38</height>
            <font>font13</font><textcolor>FFBBBBBB</textcolor><align>center</align>
            <label>Select an image to use it  •  Press Back to cancel</label>
        </control>

        <control type="panel" id="100">
            <left>120</left><top>158</top><width>1680</width><height>820</height>
            <onleft>100</onleft><onright>100</onright><onup>100</onup><ondown>100</ondown>
            <pagecontrol>300</pagecontrol><scrolltime>180</scrolltime>
            <itemlayout width="420" height="400">
                <control type="image">
                    <left>50</left><top>8</top><width>320</width><height>320</height>
                    <aspectratio align="center" aligny="center">keep</aspectratio>
